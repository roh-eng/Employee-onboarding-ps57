# ════════════════════════════════════════════════════════════════════════
#  Secure Auth Reference — environment variables
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Allowed browser origin for CORS (your frontend). In dev this is the server itself.
FRONTEND_URL=http://localhost:4000

# ── ServiceNow (TOKEN-BASED integration — not username/password) ─────────
# Your instance base URL, e.g. https://dev12345.service-now.com
SERVICENOW_INSTANCE=https://your-instance.service-now.com

# A ServiceNow OAuth access token or REST API key generated IN ServiceNow.
# This is the integration's identity. It lives ONLY on the server and is
# NEVER sent to the browser. See README.md → "Creating the ServiceNow token".
SERVICENOW_API_TOKEN=replace-with-servicenow-api-token

# Path of the Scripted REST API that validates a user's credentials.
# The backend calls it (using the token above) with { username, password }
# and gets back { valid, sysId, name, roles }. See README.md for the script.
SERVICENOW_VALIDATE_PATH=/api/x_auth/secure_auth/validate

# ── App session tokens (JWT) ────────────────────────────────────────────
# A long random secret used to sign/verify session tokens.
# Generate one with:  openssl rand -base64 48
# REQUIRED in production — the app refuses to start without it.
JWT_SECRET=replace-with-a-long-random-secret
# How long an issued session token stays valid.
JWT_EXPIRES_IN=8h
