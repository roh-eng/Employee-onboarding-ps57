# ════════════════════════════════════════════════════════════════════════
#  Secure Auth — environment variables
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ════════════════════════════════════════════════════════════════════════

# ── ServiceNow (token-based integration — never username/password) ───────
SERVICENOW_INSTANCE=https://your_instance.service-now.com
SERVICENOW_API_TOKEN=your_api_token_here

# Scripted REST path the backend calls (with the token above) to validate a
# user's credentials and read their roles. See README → "ServiceNow setup".
SERVICENOW_VALIDATE_PATH=/api/x_auth/secure_auth/validate

# ── App session tokens (JWT) ─────────────────────────────────────────────
# Generate a strong secret, e.g.:  openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h

# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Demo / test accounts (local demos only — see TEST_CREDENTIALS.md) ─────
# Three EMPLOYEE logins that work WITHOUT a live ServiceNow instance so the demo
# always works. They are also created as real users in the ServiceNow sys_user
# table. For the ADMIN side, sign in with your own ServiceNow instance admin login.
# Format: username:password:role. Disable/remove for production.
# (They are currently hardcoded in backend/routes/auth.js; expose them here if you
#  wire the demo accounts up via env instead.)
TEST_USER_EMPLOYEE_1=sarah_employee:Sarah@5678:employee
TEST_USER_EMPLOYEE_2=john_employee:John@9012:employee
TEST_USER_EMPLOYEE_3=emma_employee:Emma@3456:employee
# Admin = your real ServiceNow instance admin (resolved server-side from sys_user_has_role)
