# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Public URL of the deployed app (used for CORS, the welcome email links and the
# set-password onboarding links). In production set this to your real HTTPS URL,
# e.g. https://enterprise-workflow-hub.onrender.com
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Set to "production" in deployment — disables the demo logins.
NODE_ENV=development

# ── Authentication (JWT) ────────────────────────────────────────────────────
# REQUIRED in production/staging — the server refuses to start without it.
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=8h

# ── ServiceNow PDI ──────────────────────────────────────────────────────────
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_password_here
SERVICENOW_SCOPE=x_1850353_employ_0

# Optional — enables login for employees WITHOUT ServiceNow roles via a Scripted
# REST validate endpoint. Leave blank to use the legacy Table-API login flow.
# See secure-auth-implementation/SCRIPTED_REST_VALIDATE.md to deploy the endpoint.
# Example: SERVICENOW_VALIDATE_PATH=/api/123456/secure_auth/validate
SERVICENOW_VALIDATE_PATH=

# ── AI Assistant (Google Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Email (SMTP) — OPTIONAL (real onboarding + alert emails) ────────────────
# Used by the onboarding welcome email and POST /api/notifications/email-alert.
#
#   • Leave these BLANK → the app auto-uses a free **Ethereal** test inbox: email
#     "sends" and you get a clickable PREVIEW URL in the server log / API response
#     (not delivered to a real inbox). Zero signup — great for testing the flow.
#   • Fill these in → real delivery to the recipient's inbox.
#
# RECOMMENDED FREE PROVIDER → Brevo (formerly Sendinblue): 300 emails/day free,
# no credit card. Sign up at https://www.brevo.com → SMTP & API → SMTP, then:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<your Brevo login email>
#   SMTP_PASS=<your Brevo SMTP key>          # the SMTP key, NOT your account password
#   SMTP_FROM=Onboarding Hub <you@yourdomain.com>   # a verified sender in Brevo
# (Alternatives with similar free tiers: Mailjet 200/day, SMTP2GO 200/day,
#  Resend 100/day, or Gmail with an App Password.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── HRMS Inbound Webhook — OPTIONAL ─────────────────────────────────────────
# Shared secret used to verify the HMAC-SHA256 signature (X-HRMS-Signature
# header) on POST /api/webhooks/incoming/hrms. If unset, signature checks are
# skipped (development only — set this in production).
HRMS_WEBHOOK_SECRET=
