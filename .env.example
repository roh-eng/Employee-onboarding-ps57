# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Authentication (JWT) ────────────────────────────────────────────────────
# REQUIRED in production/staging — the server refuses to start without it.
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=8h

# ── ServiceNow PDI ──────────────────────────────────────────────────────────
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_password_here
SERVICENOW_SCOPE=x_1850353_employ_0

# ── AI Assistant (Google Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Email Alerts (SMTP) — OPTIONAL ──────────────────────────────────────────
# When SMTP_HOST and SMTP_USER are set, POST /api/notifications/email-alert
# sends real email via nodemailer. Leave blank to fall back to in-app only.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   and use a Google "App Password" (not your normal password) for SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── HRMS Inbound Webhook — OPTIONAL ─────────────────────────────────────────
# Shared secret used to verify the HMAC-SHA256 signature (X-HRMS-Signature
# header) on POST /api/webhooks/incoming/hrms. If unset, signature checks are
# skipped (development only — set this in production).
HRMS_WEBHOOK_SECRET=
