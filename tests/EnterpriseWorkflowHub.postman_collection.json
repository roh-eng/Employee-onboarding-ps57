    },
    {
      "name": "Daily Menu",
      "item": [
        {
          "name": "List Menu Items",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/menu"
          }
        },
        {
          "name": "Create Menu Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/menu",
            "body": {
              "mode": "raw",
              "raw": "{\"itemName\":\"Grilled Salmon\",\"category\":\"Lunch\",\"calories\":520,\"available\":true}"
            }
          }
        },
        {
          "name": "Menu Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/menu/analytics"
          }
        }
      ]
    },
    {
      "name": "AI Chatbot",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/chat",
            "body": {
              "mode": "raw",
              "raw": "{\"message\":\"What is the SLA status?\"}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ]
