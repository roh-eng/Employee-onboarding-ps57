            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tasks/:id",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"Completed\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "List Issues",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/issues"
          }
        },
        {
          "name": "Create Issue",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/issues",
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Login page not responsive\",\"priority\":\"High\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
